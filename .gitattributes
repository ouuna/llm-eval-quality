# 统一换行符，防止 Windows/Linux 混用导致的切分问题
# （本项目开发中曾因 CRLF 导致知识库切分失败）

# 默认按文本处理，检出时转为 LF
* text=auto eol=lf

# Windows 脚本用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary

# 报告与知识库明确指定 UTF-8
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
