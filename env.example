# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值
#
# .env 已被 .gitignore 排除，不会被提交
# 使用方式：
#   1. cp env.example .env
#   2. 填入真实值
#   3. Windows 下 setx 或直接引用 .env 中的变量
#
# 注意：本项目代码通过 os.getenv 读取环境变量，
#      不自动加载 .env 文件，需在系统环境变量中配置
#      或使用 direnv / python-dotenv 等工具
# ============================================================

# 大模型 API Key（必填）
# 智谱 GLM 示例： https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=

# API Base URL（必填）
# 智谱 GLM：https://open.bigmodel.cn/api/paas/v4
# OpenAI  ：https://api.openai.com/v1
# DeepSeek：https://api.deepseek.com/v1
OPENAI_BASE_URL=

# 模型名称（必填）
# 智谱 GLM：glm-4-flash（免费，适合高频评测调用）
# OpenAI  ：gpt-4o-mini
OPENAI_MODEL_NAME=glm-4-flash
