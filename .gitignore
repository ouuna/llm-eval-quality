# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp

# 敏感信息 —— 严禁提交
.env
.env.*
*.key
*.pem
secrets/
config_local.yaml

# 评测输出（报告类文件体积大且可重新生成）
reports/*.json
reports/*.csv
reports/*.log
logs/
*.log

# 例外：基线必须纳入版本管理。
#
# 基线是「上一次的质量水位」，它的价值全在于跨运行可比。
# 一旦不进仓库，CI 每次都是全新工作区，永远找不到基线，
# 于是 --compare-baseline 分支永远走不到，退化检测形同虚设。
# 而且把它提交上去，review 时能直接看出指标变化。
# 该文件只含指标数值，不含任何密钥。
!reports/baseline.json
